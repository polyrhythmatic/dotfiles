#!/bin/bash
# Merge base settings into ~/.claude/settings.json.
# stdin = current file contents (from chezmoi).
# Base settings always win; extra keys (permissions, hooks) are preserved.

set -euo pipefail

# Read stdin before heredoc steals it
CURRENT="$(cat)" python3 << 'PYEOF'
import json, os

base = {
    "alwaysThinkingEnabled": True,
    "skipDangerousModePermissionPrompt": True,
    "theme": "custom:alabaster-dark",
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh",
        "padding": 2,
        "refreshInterval": 5
    },
    "attribution": {"commit": "", "pr": ""},
    "env": {
        "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
        "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_NO_FLICKER": "1"
    }
}

current_str = os.environ.get("CURRENT", "")
try:
    current = json.loads(current_str) if current_str.strip() else {}
except json.JSONDecodeError:
    current = {}

def deep_merge(current, override):
    result = dict(current)
    for key, value in override.items():
        if key in result and isinstance(result[key], dict) and isinstance(value, dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = value
    return result

merged = deep_merge(current, base)

# Managed hooks are merged additively (never replace the hooks tree, so
# machine-local hooks survive). Identified by command path; idempotent.
MANAGED_HOOKS = [
    (
        "PreToolUse",
        {
            "matcher": "Bash",
            "hooks": [
                {
                    "type": "command",
                    "command": "~/.claude/hooks/browser-router-nudge.sh",
                    "timeout": 10,
                    "statusMessage": "Checking browser-tool routing",
                }
            ],
        },
    ),
]

hooks = merged.setdefault("hooks", {})
for event, entry in MANAGED_HOOKS:
    event_hooks = hooks.setdefault(event, [])
    managed_cmds = {h["command"] for h in entry["hooks"]}
    present = any(
        isinstance(e, dict)
        and any(
            isinstance(h, dict) and h.get("command") in managed_cmds
            for h in e.get("hooks", [])
        )
        for e in event_hooks
    )
    if not present:
        event_hooks.append(entry)

print(json.dumps(merged, indent=2))
PYEOF
